# Account SID (começa com AC) no Console da Twilio.
TWILIO_ACCOUNT_SID=
# API Key SID (começa com SK) e o secret exibido uma vez na criação da chave.
TWILIO_API_KEY=
TWILIO_API_SECRET=

# APIs carregadas no MCP. O pacote oficial avisa que carregar tudo estoura o contexto.
TWILIO_SERVICES=twilio_api_v2010,twilio_messaging_v1,twilio_content_v1,twilio_numbers_v2
# Opcional: recorte ainda mais fino, separado por vírgula.
TWILIO_TAGS=
