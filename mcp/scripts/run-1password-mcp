#!/usr/bin/env bash
# Cursor Electron não herda o PATH do zsh; o plugin chama `1password-mcp` e dá ENOENT.
set -euo pipefail
candidates=(
  "${HOME}/.local/opt/1Password/1password-mcp"
  /opt/1Password/1password-mcp
)
if command -v 1password-mcp >/dev/null 2>&1; then
  found="$(command -v 1password-mcp)"
  if [[ -x "$found" && "$found" != "$0" ]]; then
    exec "$found" "$@"
  fi
fi
for bin in "${candidates[@]}"; do
  if [[ -x "$bin" ]]; then
    exec "$bin" "$@"
  fi
done
echo "1password-mcp ausente. Instale o app 1Password (Labs → MCP Server) ou extraia o tar em ~/.local/opt/1Password." >&2
exit 127
