#!/bin/bash
set -e
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$ROOT/wrappers/common.sh"
python3 "$ROOT/mcp_toolkit.py" menu --client agy --profile "${MCP_PROFILE:-default}"
choose_launch_mode "AGY" || exit 0
if [[ "$launch_mode" == 2 || "$launch_mode" == 4 ]]; then choose_resume_target || exit 0; fi
case "$launch_mode" in
  1) command=(agy) ;;
  2) [[ "$resume_kind" == last ]] && command=(agy --continue) || command=(agy --conversation "$session_id") ;;
  3) command=(agy --dangerously-skip-permissions) ;;
  4) [[ "$resume_kind" == last ]] && command=(agy --dangerously-skip-permissions --continue) || command=(agy --dangerously-skip-permissions --conversation "$session_id") ;;
esac
exec "${command[@]}" "$@"
