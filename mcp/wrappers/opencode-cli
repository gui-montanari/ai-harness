#!/bin/bash
set -e
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$ROOT/wrappers/common.sh"
python3 "$ROOT/mcp_toolkit.py" menu --client opencode --profile "${MCP_PROFILE:-default}"
choose_launch_mode "OpenCode" || exit 0
if [[ "$launch_mode" == 2 || "$launch_mode" == 4 ]]; then choose_resume_target || exit 0; fi
case "$launch_mode" in
  1) command=(opencode) ;;
  2) [[ "$resume_kind" == last ]] && command=(opencode --continue) || command=(opencode --session "$session_id") ;;
  3) command=(opencode --auto) ;;
  4) [[ "$resume_kind" == last ]] && command=(opencode --auto --continue) || command=(opencode --auto --session "$session_id") ;;
esac
exec "${command[@]}" "$@"
